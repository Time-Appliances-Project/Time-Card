<Project>
  <!-- Pinned VS 2022-compatible kit for repeatable CI; installed WDK builds
       remain supported when the optional NuGet packages are absent. -->
  <PropertyGroup>
    <TimeCardKitPackages Condition="'$(TimeCardKitPackages)' == ''">$(MSBuildThisFileDirectory)packages</TimeCardKitPackages>
  </PropertyGroup>
  <Import Project="$(TimeCardKitPackages)\Microsoft.Windows.WDK.x64.10.0.26100.6584\build\native\Microsoft.Windows.WDK.x64.props"
          Condition="Exists('$(TimeCardKitPackages)\Microsoft.Windows.WDK.x64.10.0.26100.6584\build\native\Microsoft.Windows.WDK.x64.props') and '$(Platform)' == 'x64'" />
  <Import Project="$(TimeCardKitPackages)\Microsoft.Windows.SDK.CPP.x64.10.0.26100.6584\build\native\Microsoft.Windows.SDK.cpp.x64.props"
          Condition="Exists('$(TimeCardKitPackages)\Microsoft.Windows.SDK.CPP.x64.10.0.26100.6584\build\native\Microsoft.Windows.SDK.cpp.x64.props') and '$(Platform)' == 'x64'" />
  <Import Project="$(TimeCardKitPackages)\Microsoft.Windows.SDK.CPP.10.0.26100.6584\build\native\Microsoft.Windows.SDK.cpp.props"
          Condition="Exists('$(TimeCardKitPackages)\Microsoft.Windows.SDK.CPP.10.0.26100.6584\build\native\Microsoft.Windows.SDK.cpp.props')" />
</Project>
