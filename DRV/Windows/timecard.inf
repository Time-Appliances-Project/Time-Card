; SPDX-License-Identifier: BSD-3-Clause
; OCP TimeCard Windows KMDF driver (x64, Windows 10 2004 and newer).

[Version]
Signature   = "$WINDOWS NT$"
Class       = TimeCard
ClassGuid   = {B5415088-5EE1-4D3A-8519-C3487370E0BF}
Provider    = %ProviderName%
CatalogFile = timecard.cat
DriverVer   = 08/02/2026,1.43.0.0
PnpLockdown = 1

[ClassInstall32]
AddReg = TimeCard_Class.AddReg

[TimeCard_Class.AddReg]
HKR, , , 0, %TimeCardClassName%
; Keep the original OCP card artwork for the Time Card category.
; The controller and raw child PDOs select device-specific icons below.
HKR, , Icon, , "-20"
HKR, , IconPath, 0x00010000, "%13%\timecard.sys,-101"

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
timecard.sys = 1
timecard.ico = 1
timecard-phc.ico = 1
timecard-tod.ico = 1
timecard-gnss.ico = 1
timecard-gnss2.ico = 1
timecard-atomic.ico = 1
timecard-nmea.ico = 1
timecard-sma.ico = 1
timecard-timing.ico = 1
timecard-i2c.ico = 1
timecard-flash.ico = 1
timecard-ptm.ico = 1

[Manufacturer]
%ProviderName% = Standard,NTamd64.10.0...19041

[Standard.NTamd64.10.0...19041]
%MetaTimeCard.DeviceDesc% = TimeCard_Device, PCI\VEN_1D9B&DEV_0400
%CelesticaTimeCard.DeviceDesc% = TimeCard_Device, PCI\VEN_18D4&DEV_1008
%OroliaArtCard.DeviceDesc% = TimeCard_Device, PCI\VEN_1AD7&DEV_A000
%Phc.DeviceDesc%          = TimeCard_Phc, TIMECARD\PHC
%Tod.DeviceDesc%          = TimeCard_Tod, TIMECARD\TOD
%Gnss.DeviceDesc%         = TimeCard_Gnss, TIMECARD\UART_GNSS
%Gnss2.DeviceDesc%        = TimeCard_Gnss2, TIMECARD\UART_GNSS2
%AtomicClock.DeviceDesc%  = TimeCard_AtomicClock, TIMECARD\UART_MAC
%Nmea.DeviceDesc%         = TimeCard_Nmea, TIMECARD\UART_NMEA
%Sma.DeviceDesc%          = TimeCard_Sma, TIMECARD\SMA
%TimingIo.DeviceDesc%     = TimeCard_TimingIo, TIMECARD\TIMING_IO
%TimestampInputs.DeviceDesc% = TimeCard_TimingIo, TIMECARD\TIMESTAMP_INPUTS
%I2c.DeviceDesc%          = TimeCard_I2c, TIMECARD\I2C
%Flash.DeviceDesc%        = TimeCard_Flash, TIMECARD\FLASH
%Ptm.DeviceDesc%          = TimeCard_Ptm, TIMECARD\PTM

[TimeCard_Device.NT]
CopyFiles = TimeCard_CopyFiles, TimeCard_SubsystemIcons
AddProperty = TimeCard_DeviceIcon

[TimeCard_CopyFiles]
timecard.sys
timecard.ico

[TimeCard_SubsystemIcons]
timecard-phc.ico
timecard-tod.ico
timecard-gnss.ico
timecard-gnss2.ico
timecard-atomic.ico
timecard-nmea.ico
timecard-sma.ico
timecard-timing.ico
timecard-i2c.ico
timecard-flash.ico
timecard-ptm.ico

[TimeCard_DeviceIcon]
DeviceIcon,,,,"%13%\timecard.ico"

[TimeCard_Device.NT.HW]
AddReg = TimeCard_Device.NT.AddReg, TimeCard_MSI.AddReg, TimeCard_Hierarchy.AddReg

[TimeCard_Device.NT.AddReg]
HKR, , DeviceCharacteristics, 0x10001, 0x0100
; Raw clock adjustment and UART access are limited to Administrators/SYSTEM.
HKR, , Security, , "D:P(A;;GA;;;SY)(A;;GA;;;BA)"

[TimeCard_MSI.AddReg]
; Modern gateware exposes one MSI-X vector per function. The driver currently
; polls PHC/UART registers but requests the vectors because MSI-X selects the
; matching BAR layout in LitePCIe gateware, as it does in Linux ptp_ocp.
HKR, "Interrupt Management\MessageSignaledInterruptProperties", MSISupported, 0x10001, 1
HKR, "Interrupt Management\MessageSignaledInterruptProperties", MessageNumberLimit, 0x10001, 64

[TimeCard_Hierarchy.AddReg]
; Descriptive raw child PDOs are fail-open and do not touch card hardware.
; NOCLOBBER preserves an administrator's explicit persisted override.
HKR, , EnableSubsystemDevices, 0x00010003, 1

[TimeCard_Device.NT.Services]
AddService = timecard, %SPSVCINST_ASSOCSERVICE%, TimeCard_Service_Inst

[TimeCard_Service_Inst]
DisplayName    = %ServiceName%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %13%\timecard.sys

[TimeCard_Device.NT.Wdf]
KmdfService = timecard, TimeCard_WdfSect

[TimeCard_WdfSect]
KmdfLibraryVersion = 1.33

; The controller bus driver owns these functions in raw mode. Each child uses
; a null service and a device-specific icon without loading a second driver.
[TimeCard_Phc.NT]
CopyFiles = TimeCard_SubsystemIcons
AddProperty = TimeCard_PhcIcon

[TimeCard_Phc.NT.Services]
AddService = , %SPSVCINST_ASSOCSERVICE%

[TimeCard_Tod.NT]
CopyFiles = TimeCard_SubsystemIcons
AddProperty = TimeCard_TodIcon

[TimeCard_Tod.NT.Services]
AddService = , %SPSVCINST_ASSOCSERVICE%

[TimeCard_Gnss.NT]
CopyFiles = TimeCard_SubsystemIcons
AddProperty = TimeCard_GnssIcon

[TimeCard_Gnss.NT.Services]
AddService = , %SPSVCINST_ASSOCSERVICE%

[TimeCard_Gnss2.NT]
CopyFiles = TimeCard_SubsystemIcons
AddProperty = TimeCard_Gnss2Icon

[TimeCard_Gnss2.NT.Services]
AddService = , %SPSVCINST_ASSOCSERVICE%

[TimeCard_AtomicClock.NT]
CopyFiles = TimeCard_SubsystemIcons
AddProperty = TimeCard_AtomicIcon

[TimeCard_AtomicClock.NT.Services]
AddService = , %SPSVCINST_ASSOCSERVICE%

[TimeCard_Nmea.NT]
CopyFiles = TimeCard_SubsystemIcons
AddProperty = TimeCard_NmeaIcon

[TimeCard_Nmea.NT.Services]
AddService = , %SPSVCINST_ASSOCSERVICE%

[TimeCard_Sma.NT]
CopyFiles = TimeCard_SubsystemIcons
AddProperty = TimeCard_SmaIcon

[TimeCard_Sma.NT.Services]
AddService = , %SPSVCINST_ASSOCSERVICE%

[TimeCard_TimingIo.NT]
CopyFiles = TimeCard_SubsystemIcons
AddProperty = TimeCard_TimingIcon

[TimeCard_TimingIo.NT.Services]
AddService = , %SPSVCINST_ASSOCSERVICE%

[TimeCard_I2c.NT]
CopyFiles = TimeCard_SubsystemIcons
AddProperty = TimeCard_I2cIcon

[TimeCard_I2c.NT.Services]
AddService = , %SPSVCINST_ASSOCSERVICE%

[TimeCard_Flash.NT]
CopyFiles = TimeCard_SubsystemIcons
AddProperty = TimeCard_FlashIcon

[TimeCard_Flash.NT.Services]
AddService = , %SPSVCINST_ASSOCSERVICE%

[TimeCard_Ptm.NT]
CopyFiles = TimeCard_SubsystemIcons
AddProperty = TimeCard_PtmIcon

[TimeCard_Ptm.NT.Services]
AddService = , %SPSVCINST_ASSOCSERVICE%

[TimeCard_PhcIcon]
DeviceIcon,,,,"%13%\timecard-phc.ico"

[TimeCard_TodIcon]
DeviceIcon,,,,"%13%\timecard-tod.ico"

[TimeCard_GnssIcon]
DeviceIcon,,,,"%13%\timecard-gnss.ico"

[TimeCard_Gnss2Icon]
DeviceIcon,,,,"%13%\timecard-gnss2.ico"

[TimeCard_AtomicIcon]
DeviceIcon,,,,"%13%\timecard-atomic.ico"

[TimeCard_NmeaIcon]
DeviceIcon,,,,"%13%\timecard-nmea.ico"

[TimeCard_SmaIcon]
DeviceIcon,,,,"%13%\timecard-sma.ico"

[TimeCard_TimingIcon]
DeviceIcon,,,,"%13%\timecard-timing.ico"

[TimeCard_I2cIcon]
DeviceIcon,,,,"%13%\timecard-i2c.ico"

[TimeCard_FlashIcon]
DeviceIcon,,,,"%13%\timecard-flash.ico"

[TimeCard_PtmIcon]
DeviceIcon,,,,"%13%\timecard-ptm.ico"

[Strings]
SPSVCINST_ASSOCSERVICE       = 0x00000002
ProviderName                 = "Open Compute Project"
DiskName                     = "OCP TimeCard Installation Disk"
ServiceName                  = "OCP TimeCard Driver"
TimeCardClassName            = "Time Card"
MetaTimeCard.DeviceDesc      = "OCP Time Card Controller"
CelesticaTimeCard.DeviceDesc = "OCP Time Card Controller (Celestica)"
OroliaArtCard.DeviceDesc     = "Orolia ART Time Card Controller"
Phc.DeviceDesc               = "Time Card Precision Hardware Clock (PHC)"
Tod.DeviceDesc               = "Time Card GNSS Time-of-Day Engine"
Gnss.DeviceDesc              = "Time Card GNSS Receiver (UART)"
Gnss2.DeviceDesc             = "Time Card Secondary GNSS Receiver (UART)"
AtomicClock.DeviceDesc       = "Time Card Atomic Clock (UART)"
Nmea.DeviceDesc              = "Time Card NMEA Output (UART)"
Sma.DeviceDesc               = "Time Card SMA Inputs and Outputs"
TimingIo.DeviceDesc          = "Time Card Timestamp and Signal Generators"
TimestampInputs.DeviceDesc   = "Time Card Timestamp Inputs"
I2c.DeviceDesc               = "Time Card I2C Controller"
Flash.DeviceDesc             = "Time Card FPGA Firmware and SPI Flash"
Ptm.DeviceDesc               = "Time Card PCIe Precision Time Measurement (PTM)"
