<Window x:Class="TimeCardControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="OCP Time Card Control Center"
        Width="1440" Height="900" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        Background="#07111F" AllowsTransparency="False"
        Icon="Assets/timecard-app.ico"
        Loaded="Window_Loaded" Closed="Window_Closed" StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7"
                            CornerRadius="16" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Foreground" Value="#EAF3FA" />
        </Style>
        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style x:Key="StatusChip" TargetType="Border">
            <Setter Property="Background" Value="#1C332B" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="SubsystemCard" TargetType="Border" BasedOn="{StaticResource Panel}">
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="MinHeight" Value="154" />
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{StaticResource WindowBrush}" CornerRadius="16"
            BorderBrush="#274158" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0A1725" CornerRadius="16,16,0,0"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="142" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="10" Background="#07111F"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Image Source="Assets/timecard-app-icon.png" Margin="3" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="OCP TIME CARD" FontFamily="Segoe UI Semibold" FontSize="13" />
                            <TextBlock Text="CONTROL CENTER" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="TopPageTitle" Grid.Column="1" Text="Overview" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" FontFamily="Segoe UI Semibold" FontSize="13" />
                    <Button x:Name="ConnectionChip" Grid.Column="2" Style="{StaticResource SecondaryButton}"
                            Background="#102233" Padding="12,6" Margin="0,0,14,0"
                            VerticalAlignment="Center" Click="ConnectionChip_Click"
                            ToolTip="Restart with administrator access"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="{StaticResource DangerBrush}"
                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock x:Name="ConnectionText" Text="Connecting…" FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Minimize">
                            <Border Width="13" Height="2" Background="#EAF3FA" CornerRadius="1"
                                    VerticalAlignment="Center" />
                        </Button>
                        <Button Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="Maximize or restore">
                            <Border Width="12" Height="11" BorderBrush="#EAF3FA" BorderThickness="1.5"
                                    CornerRadius="1" VerticalAlignment="Center" />
                        </Button>
                        <Button Style="{StaticResource CaptionButton}" Click="Close_Click" ToolTip="Close"
                                Background="#6A2937" Foreground="White">
                            <Grid Width="12" Height="12">
                                <Path Data="M 0,0 L 12,12" Stroke="White" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Path Data="M 12,0 L 0,12" Stroke="White" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0"
                        CornerRadius="0,0,0,16">
                    <Grid Margin="0,18,0,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <Border Margin="16,0,16,16" Background="#07111F" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="10,7">
                                <Image Source="Assets/timecard-logo.png" Height="72" Stretch="Uniform" />
                            </Border>
                            <TextBlock Text="WORKSPACES" Style="{StaticResource Label}" Margin="26,0,0,10" />
                        </StackPanel>
                        <StackPanel Grid.Row="1">
                            <RadioButton x:Name="OverviewNav" GroupName="Navigation" Style="{StaticResource NavRadio}" Tag="Overview"
                                         Content="&#xE80F;" ToolTip="Overview" IsChecked="True"
                                         Checked="Navigate_Checked" />
                            <RadioButton x:Name="ClockNav" GroupName="Navigation" Style="{StaticResource NavRadio}" Tag="Clock"
                                         Content="&#xE916;" ToolTip="Precision Clock" Checked="Navigate_Checked" />
                            <RadioButton x:Name="GnssNav" GroupName="Navigation" Style="{StaticResource NavRadio}" Tag="Gnss"
                                         Content="&#xE707;" ToolTip="GNSS &amp; ToD" Checked="Navigate_Checked" />
                            <RadioButton x:Name="AtomicNav" GroupName="Navigation" Style="{StaticResource NavRadio}" Tag="Atomic"
                                         Content="&#xE950;" ToolTip="Atomic Clock" Checked="Navigate_Checked" />
                            <RadioButton x:Name="UartNav" GroupName="Navigation" Style="{StaticResource NavRadio}" Tag="Uart"
                                         Content="&#xE756;" ToolTip="UART Console" Checked="Navigate_Checked" />
                            <RadioButton x:Name="SmaNav" GroupName="Navigation" Style="{StaticResource NavRadio}" Tag="Sma"
                                         Content="&#xE9CA;" ToolTip="SMA Connectors" Checked="Navigate_Checked" />
                            <RadioButton x:Name="I2cNav" GroupName="Navigation" Style="{StaticResource NavRadio}" Tag="I2c"
                                         Content="&#xE950;" ToolTip="I&#x00B2;C Bus" Checked="Navigate_Checked" />
                            <RadioButton x:Name="SubsystemsNav" GroupName="Navigation" Style="{StaticResource NavRadio}" Tag="Subsystems"
                                         Content="&#xE713;" ToolTip="Subsystems" Checked="Navigate_Checked" />
                            <RadioButton x:Name="DiagnosticsNav" GroupName="Navigation" Style="{StaticResource NavRadio}" Tag="Diagnostics"
                                         Content="&#xE9D9;" ToolTip="Diagnostics" Checked="Navigate_Checked" />
                        </StackPanel>
                        <Border Grid.Row="2" Margin="14,0" Background="#0E1E2D" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="14">
                            <StackPanel>
                                <TextBlock Text="DRIVER SESSION" Style="{StaticResource Label}" />
                                <TextBlock x:Name="SidebarDriverText" Text="Waiting for hardware" FontFamily="Segoe UI Semibold"
                                           Margin="0,6,0,3" TextWrapping="Wrap" />
                                <TextBlock x:Name="LastRefreshText" Text="Not yet sampled" Foreground="{StaticResource MutedBrush}"
                                           FontSize="11" Margin="0,0,0,10" />
                                <TextBlock Text="CARD SERIAL" Style="{StaticResource Label}" />
                                <TextBlock x:Name="SidebarSerialText" Text="Identity not read" FontFamily="Cascadia Mono, Consolas"
                                           Foreground="{StaticResource CyanBrush}" FontSize="11" Margin="0,4,0,10" TextWrapping="Wrap" />
                                <Button x:Name="ElevateButton" Content="Restart as administrator" Click="Elevate_Click"
                                        Style="{StaticResource SecondaryButton}" Padding="10,7" FontSize="11"
                                        Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Background="{StaticResource WindowBrush}">
                    <!-- OVERVIEW -->
                    <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="32,28,32,34">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="LIVE HARDWARE OVERVIEW" Style="{StaticResource Eyebrow}" />
                                    <TextBlock Text="Precision time, at a glance." Style="{StaticResource PageTitle}" Margin="0,5,0,4" />
                                    <TextBlock Text="A unified view of the PHC, GNSS timing engine, PCIe transport, and exposed subsystems."
                                               Foreground="{StaticResource MutedBrush}" FontSize="13" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Sync from Windows" Click="SetClock_Click" Margin="0,0,10,0" />
                                    <Button Content="Refresh now" Click="Refresh_Click" Style="{StaticResource SecondaryButton}" />
                                </StackPanel>
                            </Grid>

                            <UniformGrid Grid.Row="1" Columns="4" Margin="0,26,0,22">
                                <Border Style="{StaticResource MetricPanel}">
                                    <StackPanel>
                                        <TextBlock Text="CLOCK STATE" Style="{StaticResource Label}" />
                                        <TextBlock x:Name="SyncStatusText" Text="—" Style="{StaticResource MetricValue}" Margin="0,8,0,5" />
                                        <TextBlock x:Name="SyncDetailText" Text="Awaiting telemetry" Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricPanel}">
                                    <StackPanel>
                                        <TextBlock Text="GNSS FIX" Style="{StaticResource Label}" />
                                        <TextBlock x:Name="GnssFixMetricText" Text="—" Style="{StaticResource MetricValue}" Margin="0,8,0,5" />
                                        <TextBlock x:Name="SatelliteText" Text="Satellite data pending" Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricPanel}">
                                    <StackPanel>
                                        <TextBlock Text="PCIe INTERRUPTS" Style="{StaticResource Label}" />
                                        <TextBlock x:Name="InterruptText" Text="—" Style="{StaticResource MetricValue}" Margin="0,8,0,5" />
                                        <TextBlock x:Name="LayoutText" Text="Register layout pending" Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Panel}" MinHeight="124">
                                    <StackPanel>
                                        <TextBlock Text="CLOCK ENGINE" Style="{StaticResource Label}" />
                                        <TextBlock x:Name="ClockVersionText" Text="—" Style="{StaticResource MetricValue}" Margin="0,8,0,5" />
                                        <TextBlock x:Name="ClockSourceText" Text="Source pending" Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.65*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,18,0">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Grid>
                                            <TextBlock Text="Precision Hardware Clock" Style="{StaticResource SectionTitle}" />
                                            <Border Style="{StaticResource StatusChip}" HorizontalAlignment="Right">
                                                <TextBlock x:Name="ClockChipText" Text="LIVE" Foreground="{StaticResource AccentBrush}"
                                                           FontFamily="Segoe UI Semibold" FontSize="10" />
                                            </Border>
                                        </Grid>
                                        <TextBlock x:Name="CardTimeText" Grid.Row="1" Text="---- -- --  --:--:--.------- UTC"
                                                   FontFamily="Cascadia Mono, Consolas" FontSize="30" Margin="0,32,0,10" />
                                        <Grid Grid.Row="2" Margin="0,16,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="OFFSET TO WINDOWS" Style="{StaticResource Label}" />
                                                <TextBlock x:Name="OffsetText" Text="—" FontFamily="Segoe UI Semibold" FontSize="17" Margin="0,5,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="SAMPLE WINDOW" Style="{StaticResource Label}" />
                                                <TextBlock x:Name="SamplingWindowText" Text="—" FontFamily="Segoe UI Semibold" FontSize="17" Margin="0,5,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="SYSTEM UTC" Style="{StaticResource Label}" />
                                                <TextBlock x:Name="SystemTimeText" Text="—" FontFamily="Segoe UI Semibold" FontSize="14" Margin="0,7,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource Panel}">
                                    <StackPanel>
                                        <TextBlock Text="Hardware fabric" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="Runtime availability across the Windows driver hierarchy."
                                                   Foreground="{StaticResource MutedBrush}" Margin="0,5,0,18" />
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Ellipse Width="9" Height="9" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="PCIe controller + PHC" Margin="10,0" />
                                            <TextBlock Grid.Column="2" Text="ACTIVE" Foreground="{StaticResource AccentBrush}" FontSize="10" />
                                        </Grid>
                                        <Grid Margin="0,10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Ellipse Width="9" Height="9" Fill="{StaticResource CyanBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="GNSS + ToD telemetry" Margin="10,0" />
                                            <TextBlock Grid.Column="2" Text="LIVE" Foreground="{StaticResource CyanBrush}" FontSize="10" />
                                        </Grid>
                                        <Grid Margin="0,10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Ellipse Width="9" Height="9" Fill="{StaticResource GoldBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="Four hardware UARTs" Margin="10,0" />
                                            <TextBlock Grid.Column="2" Text="READY" Foreground="{StaticResource GoldBrush}" FontSize="10" />
                                        </Grid>
                                        <Grid Margin="0,10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Ellipse Width="9" Height="9" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="Subsystem device tree" Margin="10,0" />
                                            <TextBlock x:Name="HierarchyOverviewText" Grid.Column="2" Text="—" Foreground="{StaticResource AccentBrush}" FontSize="10" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </ScrollViewer>

                    <!-- CLOCK -->
                    <ScrollViewer x:Name="ClockPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="32,28,32,34">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="PRECISION HARDWARE CLOCK" Style="{StaticResource Eyebrow}" />
                                    <TextBlock Text="Clock control &amp; cross-timestamping" Style="{StaticResource PageTitle}" Margin="0,5,0,4" />
                                    <TextBlock Text="Compare the card PHC to Windows UTC and perform an explicit one-shot synchronization."
                                               Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Set PHC from Windows" Click="SetClock_Click" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,26,0,20">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Panel}" Margin="0,0,18,0">
                                    <StackPanel>
                                        <TextBlock Text="CARD UTC" Style="{StaticResource Label}" />
                                        <TextBlock x:Name="ClockCardTimeText" Text="---- -- --  --:--:--.------- UTC"
                                                   FontFamily="Cascadia Mono, Consolas" FontSize="32" Margin="0,18,0,28" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="SYSTEM UTC MIDPOINT" Style="{StaticResource Label}" />
                                                <TextBlock x:Name="ClockSystemTimeText" Text="—" FontFamily="Cascadia Mono, Consolas" FontSize="14" Margin="0,7,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="MEASURED OFFSET" Style="{StaticResource Label}" />
                                                <TextBlock x:Name="ClockOffsetText" Text="—" FontFamily="Segoe UI Semibold" FontSize="20" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource Panel}">
                                    <StackPanel>
                                        <TextBlock Text="Synchronization" Style="{StaticResource SectionTitle}" />
                                        <TextBlock x:Name="ClockSyncText" Text="AWAITING STATUS" FontFamily="Segoe UI Semibold"
                                                   FontSize="24" Margin="0,20,0,8" />
                                        <TextBlock x:Name="ClockStatusRawText" Text="Status register —" Foreground="{StaticResource MutedBrush}" />
                                        <Separator Background="{StaticResource BorderBrush}" Margin="0,20" />
                                        <TextBlock Text="Sampling uncertainty" Style="{StaticResource Label}" />
                                        <TextBlock x:Name="ClockSamplingText" Text="—" FontSize="18" FontFamily="Segoe UI Semibold" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <UniformGrid Grid.Row="2" Columns="3">
                                <Border Style="{StaticResource MetricPanel}">
                                    <StackPanel><TextBlock Text="CLOCK CORE" Style="{StaticResource Label}" />
                                        <TextBlock x:Name="ClockVersionDetailText" Text="—" Style="{StaticResource MetricValue}" Margin="0,8,0,5" />
                                        <TextBlock Text="FPGA clock engine version" Foreground="{StaticResource MutedBrush}" /></StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricPanel}">
                                    <StackPanel><TextBlock Text="SELECTED SOURCE" Style="{StaticResource Label}" />
                                        <TextBlock x:Name="ClockSourceDetailText" Text="—" Style="{StaticResource MetricValue}" Margin="0,8,0,5" />
                                        <TextBlock Text="Raw hardware source selector" Foreground="{StaticResource MutedBrush}" /></StackPanel>
                                </Border>
                                <Border Style="{StaticResource Panel}">
                                    <StackPanel><TextBlock Text="REGISTER WINDOW" Style="{StaticResource Label}" />
                                        <TextBlock x:Name="ClockOffsetAddressText" Text="—" Style="{StaticResource MetricValue}" Margin="0,8,0,5" />
                                        <TextBlock Text="PHC BAR offset" Foreground="{StaticResource MutedBrush}" /></StackPanel>
                                </Border>
                            </UniformGrid>
                            <Border Grid.Row="3" Style="{StaticResource Panel}" Margin="0,18,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,22,0">
                                        <TextBlock Text="Clock source" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="Choose which FPGA timing input disciplines the PHC. Changes are immediate; use ToD for normal GNSS operation."
                                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                        <TextBlock Text="SOURCE" Style="{StaticResource Label}" Margin="0,0,0,5" />
                                        <ComboBox x:Name="ClockSourceCombo" SelectedIndex="1">
                                            <ComboBoxItem Tag="0">None</ComboBoxItem>
                                            <ComboBoxItem Tag="1">Time-of-Day / GNSS</ComboBoxItem>
                                            <ComboBoxItem Tag="2">IRIG-B</ComboBoxItem>
                                            <ComboBoxItem Tag="3">External PPS</ComboBoxItem>
                                            <ComboBoxItem Tag="4">PTP</ComboBoxItem>
                                            <ComboBoxItem Tag="5">RTC</ComboBoxItem>
                                            <ComboBoxItem Tag="6">DCF77</ComboBoxItem>
                                            <ComboBoxItem Tag="254">Register-controlled</ComboBoxItem>
                                            <ComboBoxItem Tag="255">External selector</ComboBoxItem>
                                        </ComboBox>
                                        <TextBlock x:Name="ClockSourceApplyStatusText" Text="Driver ABI 4 required to change source"
                                                   Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <Button x:Name="ClockSourceApplyButton" Grid.Column="2" Content="Apply source" Click="ApplyClockSource_Click"
                                            VerticalAlignment="Bottom" IsEnabled="False" />
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <!-- GNSS -->
                    <ScrollViewer x:Name="GnssPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="32,28,32,34">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="GNSS &amp; TIME-OF-DAY" Style="{StaticResource Eyebrow}" />
                                <TextBlock Text="Receiver health &amp; timing telemetry" Style="{StaticResource PageTitle}" Margin="0,5,0,4" />
                                <TextBlock Text="Decoded satellite and fix information from the Time-of-Day engine, with direct receiver access."
                                           Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                            <UniformGrid Grid.Row="1" Columns="4" Margin="0,26,0,22">
                                <Border Style="{StaticResource MetricPanel}"><StackPanel><TextBlock Text="FIX TYPE" Style="{StaticResource Label}" />
                                    <TextBlock x:Name="GnssFixText" Text="—" Style="{StaticResource MetricValue}" Margin="0,8,0,5" />
                                    <TextBlock x:Name="GnssFixValidityText" Text="Awaiting status" Foreground="{StaticResource MutedBrush}" /></StackPanel></Border>
                                <Border Style="{StaticResource MetricPanel}"><StackPanel><TextBlock Text="SATELLITES SEEN" Style="{StaticResource Label}" />
                                    <TextBlock x:Name="SatellitesSeenText" Text="—" Style="{StaticResource MetricValue}" Margin="0,8,0,5" />
                                    <TextBlock x:Name="SatelliteValidityText" Text="Awaiting status" Foreground="{StaticResource MutedBrush}" /></StackPanel></Border>
                                <Border Style="{StaticResource MetricPanel}"><StackPanel><TextBlock Text="SATELLITES LOCKED" Style="{StaticResource Label}" />
                                    <TextBlock x:Name="SatellitesLockedText" Text="—" Style="{StaticResource MetricValue}" Margin="0,8,0,5" />
                                    <TextBlock Text="Used by timing solution" Foreground="{StaticResource MutedBrush}" /></StackPanel></Border>
                                <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="UTC STATUS" Style="{StaticResource Label}" />
                                    <TextBlock x:Name="UtcMetricText" Text="—" Style="{StaticResource MetricValue}" Margin="0,8,0,5" />
                                    <TextBlock x:Name="LeapMetricText" Text="Leap data pending" Foreground="{StaticResource MutedBrush}" /></StackPanel></Border>
                            </UniformGrid>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Panel}" Margin="0,0,18,0">
                                    <StackPanel>
                                        <TextBlock Text="Receiver access" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="Open either receiver directly in the UART workspace for configuration or protocol inspection."
                                                   Foreground="{StaticResource MutedBrush}" Margin="0,5,0,20" TextWrapping="Wrap" />
                                        <Border Background="#0A1725" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Image Source="Assets/timecard-gnss.png" Width="36" Height="36" />
                                                <StackPanel Grid.Column="1"><TextBlock Text="Primary GNSS receiver" FontFamily="Segoe UI Semibold" />
                                                    <TextBlock Text="UART 0 · live polled access" Foreground="{StaticResource MutedBrush}" FontSize="11" /></StackPanel>
                                                <Button Grid.Column="2" Content="Open UART" Tag="0" Click="OpenUart_Click" Style="{StaticResource SecondaryButton}" Padding="12,7" />
                                            </Grid>
                                        </Border>
                                        <Border Background="#0A1725" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Image Source="Assets/timecard-gnss2.png" Width="36" Height="36" />
                                                <StackPanel Grid.Column="1"><TextBlock Text="Secondary GNSS receiver" FontFamily="Segoe UI Semibold" />
                                                    <TextBlock Text="UART 1 · hardware dependent" Foreground="{StaticResource MutedBrush}" FontSize="11" /></StackPanel>
                                                <Button Grid.Column="2" Content="Open UART" Tag="1" Click="OpenUart_Click" Style="{StaticResource SecondaryButton}" Padding="12,7" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource Panel}">
                                    <StackPanel>
                                        <TextBlock Text="Raw timing registers" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="Useful when validating firmware revisions and receiver integration."
                                                   Foreground="{StaticResource MutedBrush}" Margin="0,5,0,20" TextWrapping="Wrap" />
                                        <Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="GNSS status" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="GnssRawText" Grid.Column="1" Text="—" FontFamily="Consolas" /></Grid>
                                        <Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Satellite count" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="SatelliteRawText" Grid.Column="1" Text="—" FontFamily="Consolas" /></Grid>
                                        <Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="ToD status" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="TodRawText" Grid.Column="1" Text="—" FontFamily="Consolas" /></Grid>
                                        <Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="UTC status" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="UtcRawText" Grid.Column="1" Text="—" FontFamily="Consolas" /></Grid>
                                        <Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Leap register" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="LeapRawText" Grid.Column="1" Text="—" FontFamily="Consolas" /></Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.Row="3" Style="{StaticResource Panel}" Margin="0,24,0,0" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="205" /><ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="Assets/timecard-gnss.png" Width="34" Height="34" Margin="0,0,12,0" />
                                            <StackPanel>
                                                <TextBlock Text="u-blox receiver configuration" Style="{StaticResource SectionTitle}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock x:Name="UbloxModuleText" Text="Receiver not queried" FontFamily="Segoe UI Semibold" />
                                                    <TextBlock Text="  ·  " Foreground="{StaticResource MutedBrush}" />
                                                    <TextBlock x:Name="UbloxFirmwareText" Text="Firmware unknown" Foreground="{StaticResource MutedBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="RECEIVER" Style="{StaticResource Label}" Margin="0,0,0,5" />
                                        <ComboBox x:Name="UbloxReceiverCombo" SelectedIndex="0" SelectionChanged="UbloxConnection_Changed">
                                            <ComboBoxItem Tag="0">Primary · UART 0</ComboBoxItem>
                                            <ComboBoxItem Tag="1">Secondary · UART 1</ComboBoxItem>
                                        </ComboBox></StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="HOST BAUD" Style="{StaticResource Label}" Margin="0,0,0,5" />
                                        <ComboBox x:Name="UbloxBaudCombo" IsEditable="True" Text="115200" SelectionChanged="UbloxConnection_Changed">
                                            <ComboBoxItem>9600</ComboBoxItem><ComboBoxItem>38400</ComboBoxItem>
                                            <ComboBoxItem>57600</ComboBoxItem><ComboBoxItem>115200</ComboBoxItem>
                                        </ComboBox></StackPanel>
                                    <StackPanel Grid.Column="3" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Border Style="{StaticResource StatusChip}" HorizontalAlignment="Center">
                                            <TextBlock x:Name="UbloxConnectionText" Text="NOT QUERIED" Foreground="{StaticResource MutedBrush}"
                                                       FontFamily="Segoe UI Semibold" FontSize="10" />
                                        </Border>
                                        <CheckBox x:Name="UbloxPersistCheckBox" Content="Persist BBR + flash" Margin="0,8,0,0" />
                                    </StackPanel>
                                    <Button x:Name="UbloxRefreshButton" Grid.Column="4" Content="Refresh u-blox" Click="RefreshUblox_Click" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <UniformGrid Grid.Row="4" Columns="4" Margin="0,18,0,0">
                                <Border Style="{StaticResource MetricPanel}"><StackPanel>
                                    <TextBlock Text="UBX FIX" Style="{StaticResource Label}" />
                                    <TextBlock x:Name="UbloxFixText" Text="—" Style="{StaticResource MetricValue}" Margin="0,8,0,5" />
                                    <TextBlock x:Name="UbloxFixDetailText" Text="Awaiting UBX-NAV-PVT" Foreground="{StaticResource MutedBrush}" />
                                </StackPanel></Border>
                                <Border Style="{StaticResource MetricPanel}"><StackPanel>
                                    <TextBlock Text="SATELLITES" Style="{StaticResource Label}" />
                                    <TextBlock x:Name="UbloxSatelliteText" Text="—" Style="{StaticResource MetricValue}" Margin="0,8,0,5" />
                                    <TextBlock x:Name="UbloxConstellationText" Text="Awaiting UBX-NAV-SAT" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel></Border>
                                <Border Style="{StaticResource MetricPanel}"><StackPanel>
                                    <TextBlock Text="RECEIVER UTC" Style="{StaticResource Label}" />
                                    <TextBlock x:Name="UbloxUtcText" Text="—" Style="{StaticResource MetricValue}" FontSize="19" Margin="0,12,0,8" />
                                    <TextBlock x:Name="UbloxTimeAccuracyText" Text="Time accuracy unavailable" Foreground="{StaticResource MutedBrush}" />
                                </StackPanel></Border>
                                <Border Style="{StaticResource Panel}"><StackPanel>
                                    <TextBlock Text="POSITION ACCURACY" Style="{StaticResource Label}" />
                                    <TextBlock x:Name="UbloxAccuracyText" Text="—" Style="{StaticResource MetricValue}" Margin="0,8,0,5" />
                                    <TextBlock x:Name="UbloxPositionText" Text="Position unavailable" Foreground="{StaticResource MutedBrush}" />
                                </StackPanel></Border>
                            </UniformGrid>

                            <Grid Grid.Row="5" Margin="0,18,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                                <Border x:Name="UbloxRatePanel" Style="{StaticResource Panel}" Margin="0,0,18,0" IsEnabled="False">
                                    <StackPanel>
                                        <TextBlock Text="Navigation rate &amp; platform" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="The solution interval is measurement period × navigation ratio. Stationary is recommended for a fixed Time Card."
                                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,16" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <StackPanel Margin="0,0,12,12"><TextBlock Text="MEASUREMENT PERIOD (MS)" Style="{StaticResource Label}" Margin="0,0,0,5" />
                                                <TextBox x:Name="UbloxMeasurementTextBox" Text="1000" /></StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,0,12"><TextBlock Text="NAVIGATION RATIO (1–127)" Style="{StaticResource Label}" Margin="0,0,0,5" />
                                                <TextBox x:Name="UbloxNavigationRatioTextBox" Text="1" /></StackPanel>
                                            <StackPanel Grid.Row="1" Margin="0,0,12,0"><TextBlock Text="DYNAMIC MODEL" Style="{StaticResource Label}" Margin="0,0,0,5" />
                                                <ComboBox x:Name="UbloxDynamicModelCombo" SelectedIndex="1">
                                                    <ComboBoxItem Tag="0">Portable</ComboBoxItem><ComboBoxItem Tag="2">Stationary</ComboBoxItem>
                                                    <ComboBoxItem Tag="3">Pedestrian</ComboBoxItem><ComboBoxItem Tag="4">Automotive</ComboBoxItem>
                                                    <ComboBoxItem Tag="5">Sea</ComboBoxItem><ComboBoxItem Tag="6">Airborne &lt;1g</ComboBoxItem>
                                                    <ComboBoxItem Tag="7">Airborne &lt;2g</ComboBoxItem>
                                                </ComboBox></StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="MEASUREMENT TIME REFERENCE" Style="{StaticResource Label}" Margin="0,0,0,5" />
                                                <ComboBox x:Name="UbloxTimeReferenceCombo" SelectedIndex="1">
                                                    <ComboBoxItem Tag="0">UTC</ComboBoxItem><ComboBoxItem Tag="1">GPS</ComboBoxItem>
                                                    <ComboBoxItem Tag="2">GLONASS</ComboBoxItem><ComboBoxItem Tag="3">BeiDou</ComboBoxItem>
                                                    <ComboBoxItem Tag="4">Galileo</ComboBoxItem>
                                                </ComboBox></StackPanel>
                                        </Grid>
                                        <Button Content="Apply rate and model" Click="ApplyUbloxRate_Click" HorizontalAlignment="Left" Margin="0,15,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="UbloxSignalPanel" Grid.Column="1" Style="{StaticResource Panel}" IsEnabled="False">
                                    <StackPanel>
                                        <TextBlock Text="Enabled constellations" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="Constellation availability depends on the detected module and firmware. At least one system must remain enabled."
                                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,18" />
                                        <UniformGrid Columns="2">
                                            <CheckBox x:Name="UbloxGpsCheckBox" Content="GPS" Margin="0,7" />
                                            <CheckBox x:Name="UbloxGalileoCheckBox" Content="Galileo" Margin="0,7" />
                                            <CheckBox x:Name="UbloxBeiDouCheckBox" Content="BeiDou" Margin="0,7" />
                                            <CheckBox x:Name="UbloxGlonassCheckBox" Content="GLONASS" Margin="0,7" />
                                            <CheckBox x:Name="UbloxQzssCheckBox" Content="QZSS" Margin="0,7" />
                                            <CheckBox x:Name="UbloxSbasCheckBox" Content="SBAS" Margin="0,7" />
                                        </UniformGrid>
                                        <TextBlock x:Name="UbloxSignalSupportText" Text="Receiver capability has not been queried."
                                                   Foreground="{StaticResource GoldBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,14,0,10" />
                                        <Button Content="Apply constellation set" Click="ApplyUbloxSignals_Click" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="6" Margin="0,18,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="0.8*" /></Grid.ColumnDefinitions>
                                <Border x:Name="UbloxTimePulsePanel" Style="{StaticResource Panel}" Margin="0,0,18,0" IsEnabled="False">
                                    <StackPanel>
                                        <TextBlock Text="Time pulse 1" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="The Time Card normally needs an enabled, rising-edge, one-pulse-per-second output. Values are microseconds."
                                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,16" />
                                        <WrapPanel Margin="0,0,0,14">
                                            <CheckBox x:Name="UbloxTpEnabledCheckBox" Content="Enable TP1" Margin="0,0,22,0" />
                                            <CheckBox x:Name="UbloxTpSyncCheckBox" Content="Synchronize to GNSS" Margin="0,0,22,0" />
                                            <CheckBox x:Name="UbloxTpUseLockedCheckBox" Content="Use locked values" Margin="0,0,22,0" />
                                            <CheckBox x:Name="UbloxTpRisingCheckBox" Content="Rising edge at second" />
                                        </WrapPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <StackPanel Margin="0,0,12,12"><TextBlock Text="PERIOD" Style="{StaticResource Label}" Margin="0,0,0,5" /><TextBox x:Name="UbloxTpPeriodTextBox" Text="1000000" /></StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,12,12"><TextBlock Text="LOCKED PERIOD" Style="{StaticResource Label}" Margin="0,0,0,5" /><TextBox x:Name="UbloxTpLockedPeriodTextBox" Text="1000000" /></StackPanel>
                                            <StackPanel Grid.Column="2" Margin="0,0,0,12"><TextBlock Text="TIME GRID" Style="{StaticResource Label}" Margin="0,0,0,5" />
                                                <ComboBox x:Name="UbloxTpTimeGridCombo" SelectedIndex="1">
                                                    <ComboBoxItem Tag="0">UTC</ComboBoxItem><ComboBoxItem Tag="1">GPS</ComboBoxItem>
                                                    <ComboBoxItem Tag="2">GLONASS</ComboBoxItem><ComboBoxItem Tag="3">BeiDou</ComboBoxItem>
                                                    <ComboBoxItem Tag="4">Galileo</ComboBoxItem>
                                                </ComboBox></StackPanel>
                                            <StackPanel Grid.Row="1" Margin="0,0,12,0"><TextBlock Text="PULSE WIDTH" Style="{StaticResource Label}" Margin="0,0,0,5" /><TextBox x:Name="UbloxTpLengthTextBox" Text="0" /></StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="LOCKED PULSE WIDTH" Style="{StaticResource Label}" Margin="0,0,0,5" /><TextBox x:Name="UbloxTpLockedLengthTextBox" Text="100000" /></StackPanel>
                                            <Button Grid.Row="1" Grid.Column="2" Content="Apply time pulse" Click="ApplyUbloxTimePulse_Click" VerticalAlignment="Bottom" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="UbloxMessagePanel" Grid.Column="1" Style="{StaticResource Panel}" IsEnabled="False">
                                    <StackPanel>
                                        <TextBlock Text="UART 1 message rates" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="0 disables a message; 1 emits every navigation epoch. UBX input/output protocols remain enabled."
                                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,16" />
                                        <UniformGrid Columns="3">
                                            <StackPanel Margin="0,0,8,10"><TextBlock Text="UBX NAV-PVT" Style="{StaticResource Label}" Margin="0,0,0,5" /><TextBox x:Name="UbloxNavPvtRateTextBox" Text="0" /></StackPanel>
                                            <StackPanel Margin="0,0,8,10"><TextBlock Text="NMEA GGA" Style="{StaticResource Label}" Margin="0,0,0,5" /><TextBox x:Name="UbloxGgaRateTextBox" Text="1" /></StackPanel>
                                            <StackPanel Margin="0,0,0,10"><TextBlock Text="NMEA RMC" Style="{StaticResource Label}" Margin="0,0,0,5" /><TextBox x:Name="UbloxRmcRateTextBox" Text="1" /></StackPanel>
                                            <StackPanel Margin="0,0,8,0"><TextBlock Text="NMEA GSA" Style="{StaticResource Label}" Margin="0,0,0,5" /><TextBox x:Name="UbloxGsaRateTextBox" Text="1" /></StackPanel>
                                            <StackPanel Margin="0,0,8,0"><TextBlock Text="NMEA GSV" Style="{StaticResource Label}" Margin="0,0,0,5" /><TextBox x:Name="UbloxGsvRateTextBox" Text="1" /></StackPanel>
                                            <StackPanel><TextBlock Text="NMEA ZDA" Style="{StaticResource Label}" Margin="0,0,0,5" /><TextBox x:Name="UbloxZdaRateTextBox" Text="0" /></StackPanel>
                                        </UniformGrid>
                                        <Button Content="Apply message rates" Click="ApplyUbloxMessages_Click" HorizontalAlignment="Left" Margin="0,15,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </ScrollViewer>

                    <!-- ATOMIC CLOCK -->
                    <ScrollViewer x:Name="AtomicPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="32,28,32,34">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="MICROCHIP MAC-SA53" Style="{StaticResource Eyebrow}" />
                                    <TextBlock Text="Atomic clock configuration" Style="{StaticResource PageTitle}" Margin="0,5,0,4" />
                                    <TextBlock Text="Live physics-package telemetry, frequency steering, 1PPS geometry, and disciplined timing control over the C3 serial interface."
                                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Style="{StaticResource StatusChip}" Margin="0,0,10,0">
                                        <TextBlock x:Name="AtomicConnectionText" Text="NOT QUERIED" Foreground="{StaticResource MutedBrush}"
                                                   FontFamily="Segoe UI Semibold" FontSize="10" />
                                    </Border>
                                    <Button x:Name="AtomicRefreshButton" Content="Refresh SA53" Click="RefreshAtomic_Click" />
                                </StackPanel>
                            </Grid>

                            <UniformGrid Grid.Row="1" Columns="4" Margin="0,26,0,22">
                                <Border Style="{StaticResource MetricPanel}"><StackPanel>
                                    <TextBlock Text="PHYSICS LOCK" Style="{StaticResource Label}" />
                                    <TextBlock x:Name="AtomicLockText" Text="—" Style="{StaticResource MetricValue}" Margin="0,8,0,5" />
                                    <TextBlock x:Name="AtomicLockDetailText" Text="Awaiting SA53" Foreground="{StaticResource MutedBrush}" />
                                </StackPanel></Border>
                                <Border Style="{StaticResource MetricPanel}"><StackPanel>
                                    <TextBlock Text="TEMPERATURE" Style="{StaticResource Label}" />
                                    <TextBlock x:Name="AtomicTemperatureText" Text="—" Style="{StaticResource MetricValue}" Margin="0,8,0,5" />
                                    <TextBlock x:Name="AtomicTemperatureDetailText" Text="Baseplate must remain ≤ 75 °C" Foreground="{StaticResource MutedBrush}" />
                                </StackPanel></Border>
                                <Border Style="{StaticResource MetricPanel}"><StackPanel>
                                    <TextBlock Text="POWER SUPPLY" Style="{StaticResource Label}" />
                                    <TextBlock x:Name="AtomicSupplyText" Text="—" Style="{StaticResource MetricValue}" Margin="0,8,0,5" />
                                    <TextBlock x:Name="AtomicSupplyDetailText" Text="SA53 input telemetry" Foreground="{StaticResource MutedBrush}" />
                                </StackPanel></Border>
                                <Border Style="{StaticResource Panel}"><StackPanel>
                                    <TextBlock Text="ACTIVE ALARMS" Style="{StaticResource Label}" />
                                    <TextBlock x:Name="AtomicAlarmText" Text="—" Style="{StaticResource MetricValue}" Margin="0,8,0,5" />
                                    <TextBlock x:Name="AtomicAlarmDetailText" Text="Alarm word pending" Foreground="{StaticResource MutedBrush}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                                </StackPanel></Border>
                            </UniformGrid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Panel}" Margin="0,0,18,0">
                                    <StackPanel>
                                        <TextBlock Text="Clock identity" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="UART 2 · 57,600 baud · C3 protocol" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,17" />
                                        <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Device" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="AtomicDeviceText" Grid.Column="1" Text="—" FontFamily="Segoe UI Semibold" /></Grid>
                                        <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Part number" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="AtomicPartText" Grid.Column="1" Text="—" /></Grid>
                                        <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Serial" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="AtomicSerialText" Grid.Column="1" Text="—" /></Grid>
                                        <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Firmware" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="AtomicFirmwareText" Grid.Column="1" Text="—" /></Grid>
                                        <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Hardware" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="AtomicHardwareText" Grid.Column="1" Text="—" /></Grid>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource Panel}">
                                    <StackPanel>
                                        <TextBlock Text="Oscillator &amp; discipline telemetry" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="Read-only operating values reported directly by the SA53." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,15" />
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,5,16,10"><TextBlock Text="TOTAL RUNTIME" Style="{StaticResource Label}" /><TextBlock x:Name="AtomicRuntimeText" Text="—" Margin="0,5,0,0" /></StackPanel>
                                            <StackPanel Margin="0,5,0,10"><TextBlock Text="TOTAL LOCK TIME" Style="{StaticResource Label}" /><TextBlock x:Name="AtomicLocktimeText" Text="—" Margin="0,5,0,0" /></StackPanel>
                                            <StackPanel Margin="0,5,16,10"><TextBlock Text="1PPS INPUT" Style="{StaticResource Label}" /><TextBlock x:Name="AtomicPpsDetectedText" Text="—" Margin="0,5,0,0" /></StackPanel>
                                            <StackPanel Margin="0,5,0,10"><TextBlock Text="DISCIPLINE STATE" Style="{StaticResource Label}" /><TextBlock x:Name="AtomicDisciplineStateText" Text="—" Margin="0,5,0,0" /></StackPanel>
                                            <StackPanel Margin="0,5,16,10"><TextBlock Text="MEASURED PHASE" Style="{StaticResource Label}" /><TextBlock x:Name="AtomicPhaseText" Text="—" Margin="0,5,0,0" /></StackPanel>
                                            <StackPanel Margin="0,5,0,10"><TextBlock Text="EFFECTIVE TUNING" Style="{StaticResource Label}" /><TextBlock x:Name="AtomicEffectiveTuningText" Text="—" Margin="0,5,0,0" /></StackPanel>
                                            <StackPanel Margin="0,5,16,0"><TextBlock Text="DISCIPLINE TUNING" Style="{StaticResource Label}" /><TextBlock x:Name="AtomicDisciplineTuningText" Text="—" Margin="0,5,0,0" /></StackPanel>
                                            <StackPanel Margin="0,5,0,0"><TextBlock Text="LAST CORRECTION" Style="{StaticResource Label}" /><TextBlock x:Name="AtomicLastCorrectionText" Text="—" Margin="0,5,0,0" /></StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="3" Margin="0,18,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="0.8*" /><ColumnDefinition Width="1.2*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Panel}" Margin="0,0,18,0">
                                    <StackPanel>
                                        <TextBlock Text="Frequency steering" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="Digital tuning is volatile until configuration is stored. Units are fractional frequency ×10⁻¹⁵."
                                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,17" />
                                        <TextBlock Text="DIGITAL TUNING (±20,000,000)" Style="{StaticResource Label}" Margin="0,0,0,5" />
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBox x:Name="AtomicDigitalTuningTextBox" Text="0" />
                                            <Button Grid.Column="1" Content="Set volatile" Click="ApplyAtomicDigitalTuning_Click" Margin="10,0,0,0" />
                                        </Grid>
                                        <UniformGrid Columns="4" Margin="0,10,0,17">
                                            <Button Content="−10,000" Tag="-10000" Click="AdjustAtomicDigitalTuning_Click" Style="{StaticResource SecondaryButton}" Padding="8,6" Margin="0,0,6,0" />
                                            <Button Content="−1,000" Tag="-1000" Click="AdjustAtomicDigitalTuning_Click" Style="{StaticResource SecondaryButton}" Padding="8,6" Margin="0,0,6,0" />
                                            <Button Content="+1,000" Tag="1000" Click="AdjustAtomicDigitalTuning_Click" Style="{StaticResource SecondaryButton}" Padding="8,6" Margin="0,0,6,0" />
                                            <Button Content="+10,000" Tag="10000" Click="AdjustAtomicDigitalTuning_Click" Style="{StaticResource SecondaryButton}" Padding="8,6" />
                                        </UniformGrid>
                                        <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,15" />
                                        <CheckBox x:Name="AtomicAnalogEnabledCheckBox" Content="Enable analog tuning input" />
