#define IDI_TIMECARD 101
#include <winver.h>

IDI_TIMECARD ICON "timecard-class.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,48,0,0
 PRODUCTVERSION 1,48,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DRV
 FILESUBTYPE VFT2_DRV_SYSTEM
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Open Compute Project"
            VALUE "FileDescription", "Time Card KMDF Driver"
            VALUE "FileVersion", "1.48.0.0"
            VALUE "InternalName", "timecard"
            VALUE "OriginalFilename", "timecard.sys"
            VALUE "ProductName", "Time Card"
            VALUE "ProductVersion", "1.48.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
