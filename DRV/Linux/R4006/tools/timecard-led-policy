#!/usr/bin/python3
"""Apply TimeCardControlCenter-style status colors to Time Card LEDs."""

from __future__ import annotations

import argparse
import glob
import json
import re
import signal
import socket
import sys
import time
from pathlib import Path


POLL_SECONDS = 1.0
LED_BRIGHTNESS = 160

# RGB values and status labels match the Windows TimeCardControlCenter policy.
GNSS_FIXED = ((0, 180, 30), "FIX LOCKED")
GNSS_SEARCHING = ((170, 78, 0), "SEARCHING")
GNSS_FAILED = ((180, 0, 0), "NO FIX")
SMA_OUTPUT = ((0, 165, 30), "OUTPUT")
SMA_INPUT = ((0, 65, 180), "INPUT")
SMA_DISABLED = ((50, 35, 0), "DISABLED")
SMA_UNKNOWN = ((130, 55, 0), "UNKNOWN")

TOD_GNSS_FIX_OK = 1 << 16
TOD_GNSS_FIX_VALID = 1 << 28
TOD_SAT_VALID = 1 << 16


class LedPolicy:
    def __init__(self, once: bool = False) -> None:
        self.once = once
        self.stop_requested = False
        self.reported_states: dict[str, str] = {}
        self.card_missing_reported = False

    @staticmethod
    def find_card() -> Path | None:
        cards = sorted(Path("/sys/class/timecard").glob("ocp*"))
        return cards[0] if cards else None

    @staticmethod
    def find_led(name: str) -> Path | None:
        matches = sorted(
            Path(path)
            for path in glob.glob(
                f"/sys/class/leds/timecard-*:rgb:indicator-{name}"
            )
        )
        return matches[0] if matches else None

    def report(self, led_name: str, state: str) -> None:
        if self.reported_states.get(led_name) == state:
            return
        self.reported_states[led_name] = state
        print(f"{led_name}: {state}", flush=True)

    def set_led(self, name: str, policy: tuple[tuple[int, int, int], str]) -> None:
        rgb, state = policy
        led = self.find_led(name)
        if led is None:
            self.report(name, "LED DEVICE MISSING")
            return

        try:
            if (led / "multi_index").read_text().strip() != "red green blue":
                raise RuntimeError("unexpected RGB component order")

            desired_intensity = f"{rgb[0]} {rgb[1]} {rgb[2]}"
            current_intensity = (led / "multi_intensity").read_text().strip()
            current_brightness = (led / "brightness").read_text().strip()

            if current_intensity != desired_intensity:
                (led / "multi_intensity").write_text(desired_intensity + "\n")
            if current_brightness != str(LED_BRIGHTNESS):
                (led / "brightness").write_text(f"{LED_BRIGHTNESS}\n")
            self.report(name, state)
        except (OSError, RuntimeError) as exc:
            self.report(name, f"WRITE FAILED: {exc}")

    @staticmethod
    def read_sma(card: Path, connector: int) -> tuple[tuple[int, int, int], str]:
        try:
            configuration = (card / f"sma{connector}").read_text().strip()
        except OSError:
            return SMA_UNKNOWN

        if not configuration or configuration.endswith("None"):
            return SMA_DISABLED
        if configuration.startswith("OUT:"):
            return SMA_OUTPUT
        if configuration.startswith("IN:"):
            return SMA_INPUT
        return SMA_UNKNOWN

    @staticmethod
    def query_oscillatord() -> dict[str, object] | None:
        try:
            with socket.create_connection(("127.0.0.1", 2958), timeout=0.35) as sock:
                sock.settimeout(0.35)
                sock.sendall(b'{"request":0}')
                response = bytearray()
                while len(response) < 65536:
                    chunk = sock.recv(4096)
                    if not chunk:
                        break
                    response.extend(chunk)
                    try:
                        decoded = json.loads(response)
                    except json.JSONDecodeError:
                        continue
                    gnss = decoded.get("gnss")
                    return gnss if isinstance(gnss, dict) else None
        except (ConnectionError, OSError, TimeoutError):
            return None
        return None

    @staticmethod
    def read_raw_gnss(card: Path) -> tuple[int, int] | None:
        status_file = Path("/sys/kernel/debug/timecard") / card.name / "tod_status"
        try:
            status_text = status_file.read_text()
        except OSError:
            return None

        gnss_match = re.search(r"GNSS status register: 0x([0-9A-Fa-f]{8})", status_text)
        sat_match = re.search(
            r"Number of Satellites register: 0x([0-9A-Fa-f]{8})",
            status_text,
        )
        if not gnss_match or not sat_match:
            return None
        return int(gnss_match.group(1), 16), int(sat_match.group(1), 16)

    def read_gnss(self, card: Path) -> tuple[tuple[int, int, int], str]:
        monitoring = self.query_oscillatord()
        if monitoring is not None:
            if monitoring.get("fixOk") is True:
                return GNSS_FIXED
            satellites = monitoring.get("satellites_count")
            if isinstance(satellites, int) and satellites > 0:
                return GNSS_SEARCHING
            return GNSS_FAILED

        raw = self.read_raw_gnss(card)
        if raw is None:
            return GNSS_FAILED
        gnss_status, satellites = raw
        if gnss_status == 0xFFFFFFFF or satellites == 0xFFFFFFFF:
            return GNSS_FAILED
        if gnss_status & TOD_GNSS_FIX_VALID and gnss_status & TOD_GNSS_FIX_OK:
            return GNSS_FIXED
        if satellites & TOD_SAT_VALID and satellites & 0xFF:
            return GNSS_SEARCHING
        return GNSS_FAILED

    def apply_once(self) -> bool:
        card = self.find_card()
        if card is None:
            if not self.card_missing_reported:
                print("Time Card sysfs device is not available", flush=True)
                self.card_missing_reported = True
            return False

        self.card_missing_reported = False
        self.set_led("gnss1", self.read_gnss(card))
        for connector in range(1, 5):
            self.set_led(f"sma{connector}", self.read_sma(card, connector))
        return True

    def turn_off(self) -> None:
        for name in ("gnss1", "sma1", "sma2", "sma3", "sma4"):
            led = self.find_led(name)
            if led is None:
                continue
            try:
                (led / "brightness").write_text("0\n")
            except OSError:
                pass

    def request_stop(self, _signum: int, _frame: object) -> None:
        self.stop_requested = True

    def run(self) -> int:
        signal.signal(signal.SIGTERM, self.request_stop)
        signal.signal(signal.SIGINT, self.request_stop)

        if self.once:
            return 0 if self.apply_once() else 1

        try:
            while not self.stop_requested:
                self.apply_once()
                time.sleep(POLL_SECONDS)
        finally:
            self.turn_off()
        return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Apply GNSS and SMA status colors to OCP Time Card LEDs"
    )
    parser.add_argument(
        "--once", action="store_true", help="apply the current state and exit"
    )
    args = parser.parse_args()
    return LedPolicy(once=args.once).run()


if __name__ == "__main__":
    sys.exit(main())
