#ifndef TIMECARD_DRIVER_IIG
#define TIMECARD_DRIVER_IIG

#include <Availability.h>
#include <DriverKit/IOService.iig>
#include <DriverKit/IOUserClient.iig>

#include "TimeCardABI.h"

class TimeCardDriver : public IOService
{
public:
    virtual bool init() override;
    virtual void free() override;
    virtual kern_return_t Start(IOService *provider) override;
    virtual kern_return_t Stop(IOService *provider) override;
    virtual kern_return_t NewUserClient(uint32_t type,
                                        IOUserClient **userClient) override;

    kern_return_t GetInfo(TimeCardInfo *info) LOCALONLY;
    kern_return_t GetTime(TimeCardTime *time) LOCALONLY;
    kern_return_t SetTime(const TimeCardTime *time) LOCALONLY;
    kern_return_t GetCrossTimestamp(TimeCardCrossTimestamp *timestamp)
        LOCALONLY;
    kern_return_t QuerySMA(TimeCardSMAControl *control) LOCALONLY;
    kern_return_t SetSMA(const TimeCardSMAControl *request,
                         TimeCardSMAControl *response) LOCALONLY;
    kern_return_t QueryLED(TimeCardLEDControl *control) LOCALONLY;
    kern_return_t SetLED(const TimeCardLEDControl *request,
                         TimeCardLEDControl *response) LOCALONLY;
    kern_return_t GetI2CStatus(TimeCardI2CStatus *status) LOCALONLY;
    kern_return_t ProbeI2C(TimeCardI2CProbe *probe) LOCALONLY;
    kern_return_t ReadI2C(const TimeCardI2CReadRequest *request,
                          TimeCardI2CTransfer *response) LOCALONLY;
    kern_return_t QueryI2CMux(TimeCardI2CMuxControl *control) LOCALONLY;
    kern_return_t SetI2CMux(const TimeCardI2CMuxControl *request,
                            TimeCardI2CMuxControl *response) LOCALONLY;
};

#endif /* TIMECARD_DRIVER_IIG */
